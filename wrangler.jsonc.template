{
  "name": "yaame-blogu",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  // Without this the Worker's logs are neither kept nor queryable, and the only
  // window into it is a live tail that has to be running at the moment the
  // thing goes wrong.
  "observability": { "enabled": true },

  // Declared so wrangler refuses to deploy a Worker that cannot sign, instead
  // of shipping one that fails on its first request. It is also what `wrangler
  // types` reads, so Env knows this name without anything asserting it.
  //
  // The values are set with `wrangler secret put`, outside the build; nothing
  // that builds or deploys this ever reads them.
  "secrets": { "required": ["AP_KEY_JWK", "GITHUB_CLIENT_SECRET"] },

  "assets": { "directory": "./dist/client", "binding": "ASSETS" },

  // Producer only. The adapter's server entry exports `fetch` and nothing else,
  // so the consumer is a separate Worker with its own configuration.
  "queues": { "producers": [{ "queue": "yaame-ap-delivery", "binding": "AP_QUEUE" }] },

  // Comments and reactions. SQLite dialect, so the same statements run against
  // node:sqlite when DEPLOY_TARGET=node — see docs/interactions.md.
  //
  // The placeholders below are filled in by scripts/wrangler-config.mjs
  // before the build: the adapter reads the generated file at build time.
  "d1_databases": [
    { "binding": "AP_DB", "database_name": "yaame-ap-interactions", "database_id": "${CF_D1_ID}" }
  ],

  "kv_namespaces": [{ "binding": "AP_KV", "id": "${CF_KV_ID}" }],
  // Both in the same zone, which is what a Worker custom domain requires.
  // blogu.* serves the blog; the apex is where the actor lives, and its id is
  // already published, so it cannot move.
  "routes": [
    { "pattern": "blogu.yaame.dev", "custom_domain": true },
    { "pattern": "yaame.dev", "custom_domain": true }
  ]
}
