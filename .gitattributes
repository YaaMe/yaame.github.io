# Normalise line endings to LF on the way in, so that a file edited on
# another platform does not come back as a whole-file diff.
* text=auto eol=lf

*.md   text eol=lf
*.astro text eol=lf
*.ts   text eol=lf
*.css  text eol=lf
*.yml  text eol=lf
*.json text eol=lf

# Binary — leave alone
*.jpg  binary
*.png  binary
*.webp binary
*.gz   binary
