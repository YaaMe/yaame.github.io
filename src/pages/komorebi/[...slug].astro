---
import { komorebi, chapterPage } from "../../selectors/posts";
import ChapterPage from "../../components/komorebi/ChapterPage.astro";

export async function getStaticPaths() {
  const entries = await komorebi();
  return entries.map((entry) => ({
    params: { slug: entry.id === "index" ? undefined : entry.id },
    props: { entry },
  }));
}

const view = await chapterPage(Astro.props.entry);
---
<ChapterPage view={view} />
