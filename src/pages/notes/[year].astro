---
import YearPage from "../../components/notes/YearPage.astro";
import { allNotes, noteYears, noteYearPage } from "../../selectors/notes";

export async function getStaticPaths() {
  const notes = await allNotes();
  return (await noteYears()).map((year) => ({
    params: { year },
    props: { view: noteYearPage(notes, year) },
  }));
}

const { view } = Astro.props;
---
<YearPage view={view} />
