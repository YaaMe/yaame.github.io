---
import { allPosts, content } from "../../lib/posts";
import { commentsFor } from "../../lib/comments";
import Comments from "../../components/Comments.astro";
import Base from "../../layouts/Base.astro";
import { features } from "../../site.config";

export async function getStaticPaths() {
  const posts = await allPosts();
  return posts.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await content(entry);
const { y, mo, d, iso } = entry.data.date;
const comments = features.comments ? await commentsFor(entry.id) : [];
---
<Base title={entry.data.title} description={entry.data.description}>
  <article>
    <h1>{entry.data.title}</h1>
    <p class="meta">
      <time datetime={iso}>{y}-{mo}-{d}</time>
      {entry.data.tags.map((t) => <a href={`/tags/${t}/`}>#{t}</a>)}
    </p>
    <Content />
  </article>
  <Comments comments={comments} />
  <style>
    .meta { display: flex; gap: 1em; color: var(--muted); font-size: .9em; margin-block: -.5em 2em; }
    .meta a { color: var(--muted); text-decoration: none; }
  </style>
</Base>
