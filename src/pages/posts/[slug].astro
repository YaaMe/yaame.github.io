---
import { getCollection, render } from "astro:content";
import Base from "../../layouts/Base.astro";

export async function getStaticPaths() {
  const posts = await getCollection("posts");
  return posts.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const { y, mo, d, iso } = entry.data.date;
---
<Base title={entry.data.title} description={entry.data.description}>
  <article>
    <h1>{entry.data.title}</h1>
    <p class="meta">
      <time datetime={iso}>{y}-{mo}-{d}</time>
      {entry.data.tags.map((t) => <a href={`/tags/${t}/`}>#{t}</a>)}
    </p>
    <Content />
  </article>
  <style>
    .meta { display: flex; gap: 1em; color: var(--muted); font-size: .9em; margin-block: -.5em 2em; }
    .meta a { color: var(--muted); text-decoration: none; }
  </style>
</Base>
