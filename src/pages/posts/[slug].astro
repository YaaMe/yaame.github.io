---
import { allPosts, postPage } from "../../selectors/posts";
import PostPage from "../../components/posts/PostPage.astro";

export async function getStaticPaths() {
  const posts = await allPosts();
  return posts.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const view = await postPage(Astro.props.entry);
---
<PostPage view={view} />
