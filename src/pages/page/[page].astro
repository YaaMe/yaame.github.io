---
import Base from "../../layouts/Base.astro";
import PostList from "../../components/PostList.astro";
import { allPosts, pages, slice } from "../../lib/posts";

export async function getStaticPaths() {
  const posts = await allPosts();
  const total = pages(posts.length);
  // 第 1 页是 /，不在这里生成
  return Array.from({ length: total - 1 }, (_, i) => ({
    params: { page: String(i + 2) },
    props: { page: i + 2, total },
  }));
}

const { page, total } = Astro.props;
const posts = await allPosts();
---
<Base title={`Blogu · 第 ${page} 页`}>
  <PostList posts={slice(posts, page)} page={page} total={total} base="/" />
</Base>
