---
import Base from "../../../layouts/Base.astro";
import PostList from "../../../components/PostList.astro";
import { allPosts, pages, slice } from "../../../lib/posts";

export async function getStaticPaths() {
  const posts = await allPosts();
  const total = pages(posts.length);
  return Array.from({ length: total - 1 }, (_, i) => ({
    params: { page: String(i + 2) },
    props: { page: i + 2, total },
  }));
}

const { page, total } = Astro.props;
const posts = await allPosts();
---
<Base title={`归档 · 第 ${page} 页`}>
  <h1>归档</h1>
  <PostList posts={slice(posts, page)} page={page} total={total} base="/archives/" />
</Base>
