---
import Base from "../../layouts/Base.astro";
import PostList from "../../components/PostList.astro";
import { allPosts, pages, slice } from "../../lib/posts";
const posts = await allPosts();
---
<Base title="归档 · Blogu">
  <h1>归档</h1>
  <PostList posts={slice(posts, 1)} page={1} total={pages(posts.length)} base="/archives/" />
</Base>
