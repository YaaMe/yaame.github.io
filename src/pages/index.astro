---
import Base from "../layouts/Base.astro";
import { allPosts, href, periodYear } from "../lib/posts";
import { site, hero } from "../site.config";

const posts = await allPosts();

// Summaries, grouped by the year in the filename — the period covered, not
// the publication date. Sorted within a group by the same key, so the order
// never surprises.
const summaries = new Map<string, typeof posts>();
for (const p of [...posts].sort((a, b) => b.id.localeCompare(a.id))) {
  if (!p.data.tags.includes("summaries")) continue;
  const y = periodYear(p);
  if (!summaries.has(y)) summaries.set(y, []);
  summaries.get(y)!.push(p);
}

// Everything else. One post for now, newest first.
const others = posts.filter((p) => !p.data.tags.includes("summaries"));
---
<Base title={site.title}>
  {/* Guarded whole, not just its contents: a section with only a rule and
      some padding in it is the empty-box bug the intro paragraph used to be. */}
  {hero.greeting && (
    <section class="hero">
      <h1>{hero.greeting}</h1>
    </section>
  )}

  <section class="block" id="summaries">
    <h2 class="block-title">小结</h2>
    {[...summaries].map(([year, items]) => (
      <div class="year">
        <h3>{year}</h3>
        <ul>
          {items.map((p) => (
            <li>
              <a href={href(p)}>{p.data.title}</a>
              <time datetime={p.data.date.iso}>{p.data.date.y}-{p.data.date.mo}-{p.data.date.d} 发</time>
              {p.data.description && <p>{p.data.description}</p>}
            </li>
          ))}
        </ul>
      </div>
    ))}
  </section>

  {others.length > 0 && (
    <section class="block" id="others">
      <h2 class="block-title">其它</h2>
      <ul>
        {others.map((p) => (
          <li>
            <a href={href(p)}>{p.data.title}</a>
            <time datetime={p.data.date.iso}>{p.data.date.y}-{p.data.date.mo}-{p.data.date.d}</time>
            {p.data.description && <p>{p.data.description}</p>}
          </li>
        ))}
      </ul>
    </section>
  )}

  <style>
    .hero { padding-block: .5em 2em; border-bottom: 1px solid var(--border-subtle); }
    .hero h1 { margin: 0; font-size: 1.8em; }
    .block { margin-block: 3em; }
    .block-title { margin: 0 0 1.2em; font-size: .9em; font-weight: 600;
                   letter-spacing: .12em; color: var(--fg-secondary); }
    .year { margin-block: 2em; }
    .year h3 { margin: 0 0 .5em; font-size: 1em; font-weight: 600; color: var(--fg-secondary);
               font-variant-numeric: tabular-nums; letter-spacing: .06em; }
    ul { list-style: none; padding: 0; margin: 0; border-top: 1px solid var(--border-subtle); }
    li { padding-block: 1.1em; border-bottom: 1px solid var(--border-subtle); }
    li > a { font-size: 1.05em; font-weight: 600; color: var(--fg-primary); text-decoration: none; }
    li > a:hover { color: var(--link); }
    time { margin-inline-start: .8em; color: var(--fg-secondary); font-size: .85em;
           font-variant-numeric: tabular-nums; }
    li p { margin: .35em 0 0; color: var(--fg-secondary); font-size: .95em; line-height: 1.7; }
  </style>
</Base>
