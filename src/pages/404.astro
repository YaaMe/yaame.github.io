---
import NotFoundPage from "../components/not-found/NotFoundPage.astro";
import { notFoundPage } from "../selectors/site";

// GitHub Pages serves /404.html for any path it cannot resolve, so this page
// needs no route of its own — Astro emits it whatever `trailingSlash` says.
const view = notFoundPage();
---
<NotFoundPage view={view} />
