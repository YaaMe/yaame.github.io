---
import TagPage from "../../../components/tags/TagPage.astro";
import { allPosts, allTags, tagArchive, tagPage } from "../../../selectors/posts";

export async function getStaticPaths() {
  const posts = await allPosts();
  return (await allTags()).map((tag) => ({
    params: { tag }, props: { tag, ...tagArchive(posts, tag) },
  }));
}

const { tag, tagged, total } = Astro.props;
const view = tagPage(tag, tagged, 1, total);
---
<TagPage view={view} />
