---
import TagPage from "../../../../components/tags/TagPage.astro";
import { allPosts, allTags, tagArchive, tagPage } from "../../../../selectors/posts";

export async function getStaticPaths() {
  const posts = await allPosts();
  const out = [];
  for (const tag of await allTags()) {
    const { tagged, total } = tagArchive(posts, tag);
    for (let n = 2; n <= total; n++) {
      out.push({ params: { tag, page: String(n) }, props: { tag, tagged, page: n, total } });
    }
  }
  return out;
}

const { tag, tagged, page, total } = Astro.props;
const view = tagPage(tag, tagged, page, total);
---
<TagPage view={view} />
