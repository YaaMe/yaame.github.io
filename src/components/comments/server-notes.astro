---
import Comments from "../Comments.astro";
import { liveNoteCommentsForYear } from "../../selectors/interactions/comments-live";

interface Props { year: string }
Astro.response.headers.set("Cache-Control", "private, no-store");
const { year } = Astro.props;
const notes = await liveNoteCommentsForYear(year);
---
{notes.map((note) => (
  <Comments forId={note.id} comments={note.comments} state="loaded" />
))}
