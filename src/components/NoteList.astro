---
import { noteHref, noteHtml, type Note } from "../lib/notes";

interface Props {
  notes: Note[];
  /** Give each note the id its permalink points at. Only the archives may. */
  anchors?: boolean;
}
const { notes, anchors = false } = Astro.props;

const stamp = (iso: string) => iso.slice(0, 10);
---
<ul>
  {notes.map((n) => (
    <li id={anchors ? n.id : undefined}>
      <a class="stamp" href={noteHref(n)}>
        <time datetime={n.published}>{stamp(n.published)}</time>
      </a>
      <div class="body" set:html={noteHtml(n)} />
    </li>
  ))}
</ul>
<style>
  ul { list-style: none; padding: 0; margin: 0; border-top: 1px solid var(--rule); }
  /* The header is not sticky today. This is what stops a note arriving by
     fragment from sitting flush against the top of the viewport. */
  li { padding-block: 1.4em; border-bottom: 1px solid var(--rule); scroll-margin-block-start: 2em; }
  li:target { background: color-mix(in srgb, var(--accent) 7%, transparent); }
  .stamp { color: var(--muted); font-size: .85em; text-decoration: none;
           font-variant-numeric: tabular-nums; }
  .stamp:hover { color: var(--accent); }
  .body { margin-block-start: .5em; line-height: 1.8; }
  .body :global(p) { margin: 0 0 .8em; }
  .body :global(p:last-child) { margin-bottom: 0; }
  .body :global(a) { color: var(--accent); overflow-wrap: anywhere; }
</style>
