---
import { href, type Post } from "../lib/posts";
interface Props { posts: Post[]; page: number; total: number; base: string }
const { posts, page, total, base } = Astro.props;
// `base` is e.g. "/" or "/tags/summaries/"
const pageHref = (n: number) => (n === 1 ? base : `${base}page/${n}/`);
---
<ul>
  {posts.map((p) => (
    <li>
      <a href={href(p)}>{p.data.title}</a>
      <time datetime={p.data.date.iso}>{p.data.date.y}-{p.data.date.mo}-{p.data.date.d}</time>
      {p.data.description && <p>{p.data.description}</p>}
    </li>
  ))}
</ul>
{total > 1 && (
  <nav aria-label="分页">
    {page > 1 && <a href={pageHref(page - 1)} rel="prev">← 上一页</a>}
    <span>{page} / {total}</span>
    {page < total && <a href={pageHref(page + 1)} rel="next">下一页 →</a>}
  </nav>
)}
<style>
  ul { list-style: none; padding: 0; }
  li { margin-block: 2em; }
  li > a { font-size: 1.15em; font-weight: 600; color: var(--fg); text-decoration: none; }
  li > a:hover { color: var(--accent); }
  time { display: block; margin-block: .3em; color: var(--muted); font-size: .85em;
         font-variant-numeric: tabular-nums; }
  li p { margin: .4em 0 0; color: var(--muted); font-size: .95em; line-height: 1.7; }
  nav { display: flex; gap: 1.5em; align-items: baseline; margin-block-start: 3em; color: var(--muted); }
</style>
