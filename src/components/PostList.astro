---
import { postList, type Post } from "../selectors/posts";
interface Props { posts: Post[]; page: number; total: number; base: string }
const { posts, page, total, base } = Astro.props;
const view = postList(posts, page, total, base);
---
<ul>
  {view.posts.map((p) => (
    <li>
      <a href={p.href}>{p.title}</a>
      <time datetime={p.datetime}>{p.date}</time>
      {p.description && <p>{p.description}</p>}
    </li>
  ))}
</ul>
{view.pagination.visible && (
  <nav aria-label="分页">
    {view.pagination.previous && <a href={view.pagination.previous} rel="prev">← 上一页</a>}
    <span>{view.pagination.label}</span>
    {view.pagination.next && <a href={view.pagination.next} rel="next">下一页 →</a>}
  </nav>
)}
<style>
  ul { list-style: none; padding: 0; }
  li { margin-block: 2em; }
  li > a { font-size: 1.15em; font-weight: 600; color: var(--fg-primary); text-decoration: none; }
  li > a:hover { color: var(--active); }
  time { display: block; margin-block: .3em; color: var(--fg-secondary); font-size: .85em;
         font-variant-numeric: tabular-nums; }
  li p { margin: .4em 0 0; color: var(--fg-secondary); font-size: .95em; line-height: 1.7; }
  nav { display: flex; gap: 1.5em; align-items: baseline; margin-block-start: 3em; color: var(--fg-secondary); }
</style>
