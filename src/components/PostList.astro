---
import { href, type Post } from "../lib/posts";
interface Props { posts: Post[]; page: number; total: number; base: string }
const { posts, page, total, base } = Astro.props;
// base 形如 "/" 或 "/archives/" 或 "/tags/summarize/"
const pageHref = (n: number) => (n === 1 ? base : `${base}page/${n}/`);
---
<ul>
  {posts.map((p) => (
    <li>
      <time datetime={p.data.date.iso}>{p.data.date.y}-{p.data.date.mo}-{p.data.date.d}</time>
      <a href={href(p)}>{p.data.title}</a>
    </li>
  ))}
</ul>
{total > 1 && (
  <nav aria-label="分页">
    {page > 1 && <a href={pageHref(page - 1)} rel="prev">← 上一页</a>}
    <span>{page} / {total}</span>
    {page < total && <a href={pageHref(page + 1)} rel="next">下一页 →</a>}
  </nav>
)}
<style>
  ul { list-style: none; padding: 0; }
  li { display: flex; gap: 1em; align-items: baseline; margin-block: .7em; }
  time { flex: none; color: var(--muted); font-variant-numeric: tabular-nums; font-size: .9em; }
  nav { display: flex; gap: 1.5em; align-items: baseline; margin-block-start: 2.5em; color: var(--muted); }
</style>
