---
import Base from "../../layouts/Base.astro";
import type { homePage } from "../../selectors/posts";
interface Props { view: ReturnType<typeof homePage> }
const { view } = Astro.props;
---
<Base title={view.title}>
  {/* Guarded whole, not just its contents: an empty section would still draw
      its rule and padding. */}
  {view.greeting && (
    <section class="hero">
      <h1>{view.greeting}</h1>
    </section>
  )}

  {/*
      Posts here have no real title: `title` is the date from the filename,
      which the period column already shows. `description` stands in for it.
  */}
  <section class="archive">
    {view.years.map(({ year, entries }) => (
      <div class="year">
        <h2><b>{year}</b><i /></h2>
        {entries.map((p) => (
          <a class="entry" href={p.href}>
            <time datetime={p.period.datetime}>{p.period.label}</time>
            <span>{p.title}</span>
          </a>
        ))}
      </div>
    ))}
  </section>

  <style>
    .hero { padding-block: .5em 2em; border-bottom: 1px solid var(--border-subtle); }
    .hero h1 { margin: 0; font-size: 1.8em; }
    .archive { margin-block: 3em; }
    .year { margin-block: 2.2em; }
    .year h2 { display: flex; align-items: baseline; gap: .9em; margin: 0 0 .9em; }
    .year h2 b { font: 600 1.35em/1 var(--mono); color: var(--fg-secondary);
                 font-variant-numeric: tabular-nums; letter-spacing: .02em; }
    .year h2 i { flex: 1; height: 1px; background: var(--border-subtle); }

    /* The whole row is the link: there is no title to click. */
    .entry { display: grid; grid-template-columns: 4.6em 1fr; gap: 0 1.2em;
             padding-block: .8em; border-bottom: 1px solid var(--border-subtle);
             color: inherit; text-decoration: none; }
    .year h2 + .entry { border-top: 1px solid var(--border-subtle); }
    /*
     * Not --mono: this cell holds Han characters (`年结`, `02 月`), which
     * --mono would hand to another font. Tabular digits keep the column
     * aligned.
     */
    .entry time { font-size: .82em; line-height: 1.9; color: var(--fg-secondary);
                  font-variant-numeric: tabular-nums; }
    /*
     * One line per entry: this cell is the post's title.
     *
     * `min-width: 0` is required. A grid item defaults to `min-width: auto`
     * and will not shrink below its content, so the overflow never triggers,
     * the ellipsis never appears, and the cell pushes the date column away.
     *
     * Descriptions are already cut to about 28 characters plus "…", so most
     * rows fit. The ellipsis appears only when one truly does not.
     */
    .entry span { line-height: 1.7; min-width: 0;
                  white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .entry:hover span { color: var(--active); }

    /* Too narrow for two columns: stack them, or the date column squeezes the
       sentence to one character per line. */
    @media (max-width: 26em) {
      .entry { grid-template-columns: 1fr; gap: .1em; }
      .entry time { line-height: 1.4; }
    }
  </style>
</Base>
