---
import { handle, type Comment } from "../lib/interactions/comments";
import { runLabel } from "../lib/interactions/comment-runs";
import { commentHref } from "../models/content/comments";

interface Props {
  comments: Comment[];
  /** A full-profile island uses these markers while it is loading and after an empty response. */
  state?: "pending" | "loaded";
  /** The note id whose slot receives this section. */
  forId?: string;
}
const { comments, state, forId } = Astro.props;

const stamp = (iso: string) => iso.slice(0, 10);
const safeHref = (value: string) => {
  const parsed = commentHref.safeParse(value);
  return parsed.success ? parsed.data : undefined;
};
---
{(comments.length > 0 || state !== undefined) && (
  <section
    class:list={[
      "comments",
      { empty: state !== undefined && (state === "pending" || comments.length === 0) },
    ]}
    data-comments-for={forId}
    data-comments-state={state ?? "loaded"}
    aria-busy={state === "pending" ? "true" : undefined}
    hidden={state !== undefined && (state === "pending" || comments.length === 0) ? true : undefined}
  >
    {state !== "pending" && comments.length > 0 ? (
      <>
        <h2>回应</h2>
        <ol>
          {comments.map((c) => (
            <li>
              <p class="who">
                <a href={safeHref(c.author.identifier)} rel="nofollow ugc">
                  {c.author.name ?? handle(c.author)}
                </a>
                {c.author.name && <span class="at">{handle(c.author)}</span>}
                <a class="when" href={safeHref(c.objectId)} rel="nofollow ugc">
                  <time datetime={c.published}>{stamp(c.published)}</time>
                </a>
              </p>
              {c.content === undefined ? (
                <p class="gone">
                  已由作者删除{c.deletedAt && <> · {stamp(c.deletedAt)}</>}
                </p>
              ) : (
                c.content.map((paragraph) => (
                  <p class="body">
                    {paragraph.map((run) =>
                      run.type === "text" ? run.text : (
                        <a href={safeHref(run.href)} rel="nofollow ugc">{runLabel(run)}</a>
                      ),
                    )}
                  </p>
                ))
              )}
            </li>
          ))}
        </ol>
      </>
    ) : null}
  </section>
)}
<style>
  .comments { margin-block-start: 4em; padding-block-start: 2em;
              border-top: 1px solid var(--border-subtle); }
  .comments.empty { display: none; }
  h2 { margin: 0 0 1.5em; font-size: .9em; font-weight: 600;
       letter-spacing: .12em; color: var(--fg-secondary); }
  ol { list-style: none; padding: 0; margin: 0; }
  li { padding-block: 1.2em; border-bottom: 1px solid var(--border-subtle); }
  li:first-child { border-top: 1px solid var(--border-subtle); }
  .who { display: flex; gap: .8em; align-items: baseline; margin: 0 0 .5em;
         font-size: .9em; }
  .who > a { color: var(--fg-primary); text-decoration: none; overflow-wrap: anywhere; }
  .who > a:hover { color: var(--active); }
  .at { color: var(--fg-secondary); font-size: .9em; overflow-wrap: anywhere; }
  .when { color: var(--fg-secondary); font-variant-numeric: tabular-nums; margin-inline-start: auto; }
  /* Single newlines inside a paragraph are the author's, and survive without
     any markup being generated for them. */
  .body { margin: 0 0 .7em; line-height: 1.8; white-space: pre-wrap;
          overflow-wrap: anywhere; }
  .body:last-of-type { margin-bottom: 0; }
  .body a { color: var(--link); }
  .gone { margin: 0; color: var(--fg-secondary); font-size: .9em; font-style: italic; }
</style>
