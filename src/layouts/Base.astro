---
import "../styles/tokens.css";
import { site, nav, social, features, other } from "../site.config";
interface Props { title: string; description?: string }
const { title, description } = Astro.props;

// With a trailing slash is canonical. Both spellings resolve — see
// astro.config.mjs — so say which is meant, or one page counts as two.
const canonical = new URL(
  Astro.url.pathname.endsWith("/") ? Astro.url.pathname : Astro.url.pathname + "/",
  site.url,
);
import Progress from "../components/Progress.astro";
---
<!doctype html>
<html lang={site.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {(description ?? site.description) && <meta name="description" content={description ?? site.description} />}
    <link rel="canonical" href={canonical.href} />
    <link rel="alternate" type="application/rss+xml" title="Blogu" href="/rss.xml" />
    <script is:inline>
      // Must be inline and run before first paint, or a reload flashes light.
      // tokens.css uses light-dark(), so flipping color-scheme is enough.
      try {
        const t = localStorage.getItem("theme");
        if (t) document.documentElement.style.colorScheme = t;
      } catch {}
    </script>
  </head>
  <body>
    <header>
      <a class="brand" href="/">{site.title}</a>
      <nav>
        {nav.slice(1).map((n) => <a href={n.href}>{n.label}</a>)}
        {features.auth && (
          <details id="session">
            {/*
              A native disclosure. Opening, closing, Enter and Space are the
              browser's, so this works with scripting off — the same standard
              the bird and the shrinking header are held to.

              The name stays `menu` in both states. `aria-label` overrides the
              visible text, so a screen reader hears `menu` rather than the
              handle; the handle is the first item inside, and on /login.
            */}
            <summary aria-label="menu">@</summary>
            <div class="panel">
              {/*
                Straight at the flow, not at a page that holds a button to
                start it. /login stays a route — the callback sends its errors
                there — but nothing navigates to it just to log in.

                The mark alone, because GitHub is the whole of what this does:
                a word beside it would be saying the same thing twice. The
                name is on the link, since the drawing carries none.
              */}
              <a href="/auth/github" aria-label="用 GitHub 登录">
                <svg class="gh" viewBox="0 0 16 16" width="16" height="16" aria-hidden="true">
                  <path d="M8 0c4.42 0 8 3.58 8 8a8.013 8.013 0 0 1-5.45 7.59c-.4.08-.55-.17-.55-.38 0-.27.01-1.13.01-2.2 0-.75-.25-1.23-.54-1.48 1.78-.2 3.65-.88 3.65-3.95 0-.88-.31-1.59-.82-2.15.08-.2.36-1.02-.08-2.12 0 0-.67-.22-2.2.82-.64-.18-1.32-.27-2-.27-.68 0-1.36.09-2 .27-1.53-1.03-2.2-.82-2.2-.82-.44 1.1-.16 1.92-.08 2.12-.51.56-.82 1.28-.82 2.15 0 3.06 1.86 3.75 3.64 3.95-.23.2-.44.55-.51 1.07-.46.21-1.61.55-2.33-.66-.15-.24-.6-.83-1.23-.82-.67.01-.27.38.01.53.34.19.73.9.82 1.13.16.45.68 1.31 2.69.94 0 .67.01 1.3.01 1.49 0 .21-.15.45-.55.38A7.995 7.995 0 0 1 0 8c0-4.42 3.58-8 8-8Z"/>
                </svg>
              </a>
            </div>
            <script is:inline>
              // Inline and immediately after the element, so it runs while the
              // header is being parsed and before anything is painted — the
              // same reason the theme script is where it is. Deferring this,
              // or fetching it, is what made every navigation flash `login`
              // before the name arrived.
              //
              // Written by /login, which is the only page that knows. This is
              // a display hint and nothing reads it as evidence of anything:
              // every privileged path asks the server, which asks the session.
              try {
                const d = document.getElementById("session");
                const summary = d.querySelector("summary");
                const panel = d.querySelector(".panel");
                const who = localStorage.getItem("session");

                // The signed-out panel as the server sent it, kept so that
                // signing out can put it back rather than ask for the page
                // again. Cloned before anything below touches the live one.
                const markup = panel.cloneNode(true);

                if (who) {
                  // The glyph gains a name; `aria-label` is untouched, so the
                  // control keeps announcing itself as the menu it still is.
                  summary.textContent = "@" + who;

                  panel.textContent = "";

                  // Not a link: the summary above already says this, and
                  // /login has nothing further to offer once 登出 is here. It
                  // stays as text because `aria-label` hides the summary's own
                  // wording, so this is where the handle is actually read out.
                  const me = document.createElement("span");
                  me.className = "who";
                  me.textContent = "@" + who;

                  // POST, because a GET gets issued unasked — a prefetch of
                  // this very item would log you out before it was clicked.
                  // The route destroys the record and clears the cookie, and
                  // that is the logout; everything below is only the bar
                  // catching up with it.
                  const out = document.createElement("button");
                  out.type = "button";
                  out.textContent = "登出";
                  out.addEventListener("click", async () => {
                    out.disabled = true;
                    try {
                      // Only on a 2xx. The key is a display hint and decides
                      // nothing, so clearing it after a request that never
                      // landed would show a signed-out bar over a session
                      // still open on the server — the one lie this must not
                      // tell. A 204 is the client learning, authoritatively,
                      // that the session is gone.
                      const res = await fetch("/auth/logout", { method: "POST" });
                      if (!res.ok) { out.disabled = false; return; }
                      localStorage.removeItem("session");

                      // No reload. Nothing on these pages is rendered from the
                      // session — they are static files, and the bar is drawn
                      // from the hint above — so there is nothing to fetch
                      // again. Put back the markup the server sent, which is
                      // the signed-out state by definition.
                      summary.textContent = "@";
                      panel.replaceChildren(...markup.cloneNode(true).childNodes);
                    } catch { out.disabled = false; }
                  });

                  // Built as nodes rather than markup: the handle comes back
                  // out of storage, and innerHTML would make it executable.
                  panel.append(me, out);
                }

                // The two things `details` has no opinion about. Escape also
                // puts focus back where it started, which `details` does only
                // for a click on the summary.
                addEventListener("keydown", (e) => {
                  if (e.key === "Escape" && d.open) { d.open = false; summary.focus(); }
                });
                addEventListener("pointerdown", (e) => {
                  if (d.open && !d.contains(e.target)) d.open = false;
                });
              } catch {}
            </script>
          </details>
        )}
        {features.darkMode && <button id="theme" type="button" aria-label="切换明暗">◐</button>}
      </nav>
    </header>
    <main><slot /></main>
    <Progress />
    <footer>
      <p>
        {social.map((s) => <a href={s.href}>{s.label}</a>)}
        <a href="/rss.xml">RSS</a>
      </p>
      <p class="muted">
        © {site.author}
        <a href={other + Astro.url.pathname}>{new URL(other).host}</a>
      </p>
    </footer>
    <script is:inline>
      document.getElementById("theme")?.addEventListener("click", () => {
        const root = document.documentElement;
        // Fall back to the system value so the first click always inverts
        const now =
          root.style.colorScheme ||
          (matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light");
        const next = now === "dark" ? "light" : "dark";
        root.style.colorScheme = next;
        try { localStorage.setItem("theme", next); } catch {}
      });
    </script>
    <style is:global>
      body {
        background: var(--bg-page); color: var(--fg-primary);
        font-family: var(--font); font-size: var(--size); line-height: var(--lh);
        text-autospace: normal;        /* CJK-Latin spacing, handled natively */
        margin: 0;
      }
      header, main, footer { max-width: var(--measure); margin-inline: auto; padding-inline: var(--gutter); }
      header { display: flex; flex-wrap: wrap; gap: 1em 1.4em; align-items: baseline; }
      header nav { display: flex; gap: 1.2em; align-items: baseline; }
      /*
       * `font-family: inherit` is the load-bearing line. A button does not
       * inherit the page font, so this was resolving to the UA stack, Arial
       * had no U+25D0, and the glyph came from Hiragino Sans — a Japanese
       * face, with metrics that match nothing beside it.
       *
       * Then .88em: measured at 17px, the disc's ink is 13.2 tall against the
       * 11.4 of the text next to it. Scaling lands both within .3px, and a
       * circle wants the last fraction of that to stay — a round shape reads
       * smaller than a flat-topped letter of the same height.
       */
      #theme { background: none; border: 0; padding: 0; cursor: pointer;
               color: var(--fg-secondary); font-family: inherit;
               font-size: .88em; line-height: 1; }
      #theme:hover { color: var(--fg-primary); }
      /*
       * The session menu. `--bg-raised` earns its first user here: a panel
       * over running text is exactly the case the token was defined for, and
       * it is the only surface on the site that sits above another one.
       */
      #session { position: relative; }
      #session > summary {
        list-style: none; cursor: pointer;
        color: var(--fg-secondary); line-height: 1;
      }
      #session > summary::-webkit-details-marker { display: none; }
      #session > summary:hover, #session[open] > summary { color: var(--fg-primary); }
      #session .panel {
        position: absolute; inset-inline-end: 0; top: calc(100% + .7em); z-index: 5;
        display: flex; flex-direction: column; align-items: start; gap: .1em;
        padding: .5em .8em;            /* sized by its contents: one mark, or a name and a verb */
        background: var(--bg-raised); border: 1px solid var(--border-subtle);
      }
      #session .panel .who { padding: .3em 0; color: var(--fg-primary); white-space: nowrap; }
      #session .panel a, #session .panel button {
        padding: .3em 0; border: 0; background: none;
        color: var(--fg-secondary); font: inherit; text-decoration: none;
        white-space: nowrap; cursor: pointer;
      }
      #session .panel a:hover, #session .panel button:hover { color: var(--link); }
      #session .panel .gh { display: block; width: 1.15em; height: 1.15em; fill: currentColor; }
      .brand { color: var(--fg-primary); text-decoration: none; font-weight: 600; letter-spacing: .04em; }
      footer { border-top: 1px solid var(--border-subtle); margin-block-start: 4em; padding-block: 1.5em 3em; font-size: .9em; }
      footer p { display: flex; gap: 1.2em; margin-block: .4em; }
      .muted { color: var(--fg-secondary); }
      /*
       * Sticky, and it shrinks on the way. The padding animates across the
       * first 80px of scroll rather than snapping at a threshold, so nothing
       * jumps — and it is the same scroll-driven CSS as the bird, so there is
       * still no listener anywhere on the page.
       *
       * The hairline fades in over the same range: in flow the header needs no
       * rule beneath it; stuck above moving text it does.
       */
      header {
        position: sticky; top: 0; z-index: 4;
        background: var(--bg-page);
        padding-block: 2rem 1rem;
        border-block-end: 1px solid transparent;
        animation: header-shrink linear both;
        animation-timeline: scroll(root block);
        animation-range: 0 80px;
      }
      @keyframes header-shrink {
        to { padding-block: .7rem .6rem;
             border-block-end-color: var(--border-subtle); }
      }
      header nav a, footer a { color: var(--fg-secondary); text-decoration: none; }
      h1, h2, h3 { line-height: 1.4; text-wrap: balance; }
      p { margin-block: 1.4em; }
      a { color: var(--link); text-underline-offset: .2em; }
      img { max-width: 100%; height: auto; }
      blockquote {
        border-inline-start: 2px solid var(--border-subtle);
        padding-inline-start: 1em; margin-inline: 0; color: var(--fg-secondary);
      }
      time { color: var(--fg-secondary); font-size: .9em; }
      hr { border: 0; border-top: 1px solid var(--border-subtle); margin-block: 2.5em; }
    </style>
  </body>
</html>
