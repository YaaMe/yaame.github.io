---
import "../styles/tokens.css";
import { site, nav, social, features, other } from "../site.config";
interface Props { title: string; description?: string }
const { title, description } = Astro.props;

// The slash form is the canonical one. Both resolve now — see astro.config.mjs
// — so say which is meant, or the same page counts twice.
const canonical = new URL(
  Astro.url.pathname.endsWith("/") ? Astro.url.pathname : Astro.url.pathname + "/",
  site.url,
);
import Progress from "../components/Progress.astro";
---
<!doctype html>
<html lang={site.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {(description ?? site.description) && <meta name="description" content={description ?? site.description} />}
    <link rel="canonical" href={canonical.href} />
    <link rel="alternate" type="application/rss+xml" title="Blogu" href="/rss.xml" />
    <script is:inline>
      // Must be inline and run before first paint, or a reload flashes light.
      // tokens.css uses light-dark(), so flipping color-scheme is enough.
      try {
        const t = localStorage.getItem("theme");
        if (t) document.documentElement.style.colorScheme = t;
      } catch {}
    </script>
  </head>
  <body>
    <header>
      <a class="brand" href="/">{site.title}</a>
      <nav>
        {nav.slice(1).map((n) => <a href={n.href}>{n.label}</a>)}
        {features.auth && (
          <>
            <a id="session" href="/login" title="登录" aria-label="登录">@</a>
            <script is:inline>
              // Inline and immediately after the element, so it runs while the
              // header is being parsed and before anything is painted — the
              // same reason the theme script is where it is. Deferring this,
              // or fetching it, is what made every navigation flash `login`
              // before the name arrived.
              //
              // Written by /login, which is the only page that knows. This is
              // a display hint and nothing reads it as evidence of anything:
              // every privileged path asks the server, which asks the session.
              try {
                // Logged out the link is a bare `@` — an address with nobody
                // at it. Signing in appends the name rather than swapping the
                // glyph, so the two states are one mark at two lengths.
                const who = localStorage.getItem("session");
                const el = document.getElementById("session");
                if (who) { el.textContent = "@" + who; el.title = el.ariaLabel = "@" + who; }
              } catch {}
            </script>
          </>
        )}
        {features.darkMode && <button id="theme" type="button" aria-label="切换明暗">◐</button>}
      </nav>
    </header>
    <main><slot /></main>
    <Progress />
    <footer>
      <p>
        {social.map((s) => <a href={s.href}>{s.label}</a>)}
        <a href="/rss.xml">RSS</a>
      </p>
      <p class="muted">
        © {site.author}
        <a href={other + Astro.url.pathname}>{new URL(other).host}</a>
      </p>
    </footer>
    <script is:inline>
      document.getElementById("theme")?.addEventListener("click", () => {
        const root = document.documentElement;
        // Fall back to the system value so the first click always inverts
        const now =
          root.style.colorScheme ||
          (matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light");
        const next = now === "dark" ? "light" : "dark";
        root.style.colorScheme = next;
        try { localStorage.setItem("theme", next); } catch {}
      });
    </script>
    <style is:global>
      body {
        background: var(--bg-page); color: var(--fg-primary);
        font-family: var(--font); font-size: var(--size); line-height: var(--lh);
        text-autospace: normal;        /* CJK-Latin spacing, handled natively */
        margin: 0;
      }
      header, main, footer { max-width: var(--measure); margin-inline: auto; padding-inline: var(--gutter); }
      header { display: flex; flex-wrap: wrap; gap: 1em 1.4em; align-items: baseline; }
      header nav { display: flex; gap: 1.2em; align-items: baseline; }
      #theme { background: none; border: 0; padding: 0; cursor: pointer;
               color: var(--fg-secondary); font-size: 1em; line-height: 1; }
      #theme:hover { color: var(--fg-primary); }
      .brand { color: var(--fg-primary); text-decoration: none; font-weight: 600; letter-spacing: .04em; }
      footer { border-top: 1px solid var(--border-subtle); margin-block-start: 4em; padding-block: 1.5em 3em; font-size: .9em; }
      footer p { display: flex; gap: 1.2em; margin-block: .4em; }
      .muted { color: var(--fg-secondary); }
      /*
       * Sticky, and it shrinks on the way. The padding animates across the
       * first 80px of scroll rather than snapping at a threshold, so nothing
       * jumps — and it is the same scroll-driven CSS as the bird, so there is
       * still no listener anywhere on the page.
       *
       * The hairline fades in over the same range: in flow the header needs no
       * rule beneath it; stuck above moving text it does.
       */
      header {
        position: sticky; top: 0; z-index: 4;
        background: var(--bg-page);
        padding-block: 2rem 1rem;
        border-block-end: 1px solid transparent;
        animation: header-shrink linear both;
        animation-timeline: scroll(root block);
        animation-range: 0 80px;
      }
      @keyframes header-shrink {
        to { padding-block: .7rem .6rem;
             border-block-end-color: var(--border-subtle); }
      }
      header nav a, footer a { color: var(--fg-secondary); text-decoration: none; }
      h1, h2, h3 { line-height: 1.4; text-wrap: balance; }
      p { margin-block: 1.4em; }
      a { color: var(--link); text-underline-offset: .2em; }
      img { max-width: 100%; height: auto; }
      blockquote {
        border-inline-start: 2px solid var(--border-subtle);
        padding-inline-start: 1em; margin-inline: 0; color: var(--fg-secondary);
      }
      time { color: var(--fg-secondary); font-size: .9em; }
      hr { border: 0; border-top: 1px solid var(--border-subtle); margin-block: 2.5em; }
    </style>
  </body>
</html>
