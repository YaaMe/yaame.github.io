---
import Badge from "./Badge.astro";
---
{/*
  The one deferred island on the site. The page itself stays a static file
  served ahead of the Worker; only this fetches, and only to learn who is
  reading. The fallback is what a visitor sees first and what they see if the
  island never arrives, so it is the honest resting state rather than a
  spinner.
*/}
<Badge server:defer>
  <a slot="fallback" class="session" href="/login">登录</a>
</Badge>
