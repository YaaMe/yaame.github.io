---
import LoginPage from "../../../components/auth/LoginPage.astro";
import { readSessionCookie } from "../../../params/auth.ts";
import { loginPage } from "../../../selectors/auth/login.ts";
import { current } from "../../../services/session.ts";

export const prerender = false;

const session = await current(readSessionCookie(Astro.request));
const data = loginPage(session, Astro.url.searchParams.get("error"));
---
<LoginPage data={data} />
