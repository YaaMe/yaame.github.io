---
import Base from "../../../layouts/Base.astro";
import { site } from "../../../site.config";
import { current } from "../session";

export const prerender = false;

const session = await current(Astro.request);
const error = Astro.url.searchParams.get("error");

const WHY: Record<string, string> = {
  state: "请求没有带上我们发出的凭据，登录已中止。重新点一次即可。",
  code: "GitHub 没有回传授权码。",
  exchange: "跟 GitHub 换令牌失败，可能是授权码过期了。",
  user: "换到了令牌，但读不到你的账号信息。",
  config: "这一侧还没配置好，不是你的问题。",
};

const ROLE: Record<string, string> = {
  owner: "站长",
  allowed: "名单内",
  guest: "访客",
};
---
<Base title={`login · ${site.title}`}>
  <h1>login</h1>

  {error && <p class="error">{WHY[error] ?? "登录没有完成。"}</p>}

  {session ? (
    <div class="who">
      <p>
        <strong>{session.name ?? session.login}</strong>
        <span class="at">@{session.login}</span>
        <span class="role">{ROLE[session.role]}</span>
      </p>
      <form method="post" action="/auth/logout">
        <button type="submit">登出</button>
      </form>
    </div>
  ) : (
    <div class="who">
      <a class="button" href="/auth/github">用 GitHub 登录</a>
    </div>
  )}

  <style>
    h1 { margin: 0 0 1.5em; font-size: 1.8em; }
    .who p { margin: 0 0 .8em; }
    .at { margin-inline-start: .5em; color: var(--muted); }
    .role { margin-inline-start: .8em; color: var(--muted); font-size: .9em; }
    .error { margin: 0 0 1.5em; padding: .8em 1em; border: 1px solid var(--rule);
             color: var(--muted); }
    .button, button { display: inline-block; margin-block-start: .5em;
                      padding: .6em 1.1em; border: 1px solid var(--rule);
                      background: none; color: var(--fg); font: inherit;
                      text-decoration: none; cursor: pointer; }
    .button:hover, button:hover { border-color: var(--accent); color: var(--accent); }
  </style>
  <script is:inline set:html={`
    // The authoritative page writes what the others read. A session that ends
    // server-side leaves this behind until the next visit here, which is why
    // it decides nothing.
    try {
      ${session ? `localStorage.setItem("session", ${JSON.stringify(session.login)})` : 'localStorage.removeItem("session")'};
    } catch {}
  `} />
</Base>
