{
  "posts": {
    "layers": [
      {
        "git": "src/content/posts/**/*.md",
        "format": "markdown"
      }
    ],
    "writeBack": [],
    "origin": "owner",
    "recovery": "keep",
    "purposes": ["content"],
    "description": "Written by the author in git."
  },
  "posts.pinned": {
    "layers": [
      {
        "ref": "posts",
        "fields": ["pinned"]
      }
    ],
    "writeBack": [],
    "origin": "owner",
    "recovery": "keep",
    "purposes": ["content", "federation"],
    "description": "Frontmatter field; federation serves it as featured."
  },
  "notes": {
    "layers": [
      {
        "git": "src/content/notes/**/*.json",
        "format": "json"
      }
    ],
    "writeBack": [],
    "origin": "owner",
    "recovery": "keep",
    "purposes": ["content", "federation"],
    "description": "Short posts in one JSON archive per year, written by the author in git."
  },
  "komorebi": {
    "layers": [
      {
        "git": "src/content/komorebi/**/*.md",
        "format": "markdown"
      }
    ],
    "writeBack": [],
    "origin": "owner",
    "recovery": "keep",
    "purposes": ["content", "federation"],
    "description": "The serialised novel, written by the author in git."
  },
  "follow-intent": {
    "layers": [
      {
        "git": "src/integrations/activitypub/following.json",
        "format": "json"
      }
    ],
    "writeBack": [],
    "origin": "owner",
    "recovery": "keep",
    "purposes": ["federation"],
    "description": "Handles the author intends to follow; the Worker reconciles them after deploy."
  },
  "followers": {
    "layers": [
      {
        "sql": "followers",
        "columns": {
          "id": "id",
          "source": "source",
          "identifier": "identifier",
          "inbox": "inbox",
          "sharedInbox": "shared_inbox",
          "followId": "follow_id",
          "followedAt": "followed_at"
        }
      }
    ],
    "writeBack": [],
    "origin": "others",
    "recovery": "keep",
    "purposes": ["federation"],
    "description": "Who follows this account, one row each keyed by their visitor identity id; federated rows carry the inboxes that receive deliveries."
  },
  "following": {
    "layers": [
      {
        "records": "ap:following",
        "format": "json"
      }
    ],
    "writeBack": [],
    "origin": "others",
    "recovery": "keep",
    "purposes": ["federation"],
    "description": "Remote actors whose acceptance of a follow is currently recorded."
  },
  "follow-ledger": {
    "layers": [
      {
        "records": "ap:follow-intent",
        "format": "json"
      }
    ],
    "writeBack": [],
    "origin": "owner",
    "recovery": "keep",
    "purposes": ["federation"],
    "description": "Resolved actor ids for follow intent, carried with the owner's federation ledger and reconciled from git intent."
  },
  "deliveries": {
    "layers": [
      {
        "sql": "deliveries",
        "columns": {
          "id": "id",
          "channel": "channel",
          "target": "target",
          "enqueuedAt": "enqueued_at"
        }
      }
    ],
    "writeBack": [],
    "origin": "owner",
    "recovery": "keep",
    "purposes": ["federation"],
    "description": "One row per channel and post whose delivery was handed over, written after that hand-over succeeded; a post without one is still pending on that channel."
  },
  "note-digests": {
    "layers": [
      {
        "records": "ap:note-digests",
        "format": "json"
      }
    ],
    "writeBack": [],
    "origin": "owner",
    "recovery": "keep",
    "purposes": ["federation"],
    "description": "Fingerprints of the notes last announced to followers."
  },
  "delivery-failures": {
    "layers": [
      {
        "records": "ap:delivery-failures",
        "format": "json"
      }
    ],
    "writeBack": [],
    "origin": "owner",
    "recovery": "reset",
    "purposes": ["federation", "bookkeeping"],
    "description": "Inbox delivery attempts written off after the retry ceiling."
  },
  "departures": {
    "layers": [
      {
        "records": "ap:departures",
        "format": "json"
      }
    ],
    "writeBack": [],
    "origin": "others",
    "recovery": "reset",
    "purposes": ["federation", "bookkeeping"],
    "description": "Recent reasons remote actors left the follower or following lists."
  },
  "actor-digest": {
    "layers": [
      {
        "records": "ap:actor-digest",
        "format": "text"
      }
    ],
    "writeBack": [],
    "origin": "owner",
    "recovery": "rebuild",
    "purposes": ["federation"],
    "description": "Fingerprint of the actor document last announced to followers."
  },
  "sessions": {
    "layers": [
      {
        "records": "auth:session:{id}",
        "format": "json"
      }
    ],
    "writeBack": [],
    "list": "never",
    "origin": "owner",
    "recovery": "ephemeral",
    "purposes": ["auth"],
    "description": "Opaque browser sessions; they expire and are not part of a portable recovery."
  },
  "fedify-state": {
    "layers": [
      {
        "memory": "fedify"
      }
    ],
    "writeBack": [],
    "origin": "system",
    "recovery": "ephemeral",
    "purposes": ["federation"],
    "description": "Fedify-managed state behind its KvStore interface; the library owns its internal keys."
  },
  "queue-ordering": {
    "layers": [
      {
        "records": true,
        "format": "cloudflare-queue-ordering"
      }
    ],
    "list": "never",
    "writeBack": [],
    "origin": "system",
    "recovery": "reset",
    "purposes": ["federation"],
    "description": "Ordering locks used by the host queue binding; the queue library owns their keys."
  },
  "reactions": {
    "layers": [
      {
        "sql": "reactions",
        "columns": {
          "id": "id",
          "source": "source",
          "identifier": "identifier",
          "authorId": "author_id",
          "activityId": "activity_id",
          "objectId": "object_id",
          "target": "target",
          "kind": "kind",
          "receivedAt": "received_at",
          "undoneAt": "undone_at"
        }
      }
    ],
    "writeBack": [],
    "origin": "others",
    "recovery": "keep",
    "purposes": ["federation", "content"],
    "description": "Incoming likes and boosts, keyed by the computed id and retained so de-duplication and undo remain durable."
  },
  "migrations": {
    "layers": [
      {
        "sql": "migrations",
        "columns": {
          "version": "version",
          "appliedAt": "applied_at"
        }
      }
    ],
    "writeBack": [],
    "origin": "system",
    "recovery": "keep",
    "purposes": ["deployment"],
    "description": "Schema version bookkeeping for the append-only migration list."
  },
  "comments": {
    "layers": [
      {
        "sql": "comments",
        "columns": {
          "id": "id",
          "source": "source",
          "identifier": "identifier",
          "authorId": "author_id",
          "activityId": "activity_id",
          "objectId": "object_id",
          "submissionId": "submission_id",
          "inReplyTo": "in_reply_to",
          "root": "root",
          "replyTo": "reply_to",
          "content": "content",
          "published": "published",
          "receivedAt": "received_at",
          "deletedAt": "deleted_at",
          "promotedAt": "promoted_at"
        }
      }
    ],
    "writeBack": [],
    "origin": "others",
    "recovery": "keep",
    "purposes": ["federation", "content"],
    "description": "Every reply the inbox stored, promoted or not; the ledger promotion and withdrawal work from."
  },
  "visitor-identities": {
    "layers": [
      {
        "sql": "visitor_identities",
        "columns": {
          "id": "id",
          "source": "source",
          "identifier": "identifier",
          "name": "name"
        }
      }
    ],
    "writeBack": [],
    "origin": "others",
    "recovery": "keep",
    "purposes": ["identity", "federation", "content"],
    "description": "Visitor authorship within a source, keyed by the computed id. Raw identifiers are retained; display names are cached."
  },
  "promoted-comments": {
    "layers": [
      {
        "git": "src/content/comments/{posts,notes}/*.json",
        "format": "json"
      },
      {
        "ref": "comments",
        "fields": ["deletedAt"]
      }
    ],
    "writeBack": ["promote", "tombstone"],
    "origin": "others",
    "recovery": "keep",
    "purposes": ["content"],
    "description": "Base: chosen comments in git, joined to SQL by comment id, with the author's visitor identity and stored id inputs. Delta, applied on read: withdrawals (deletedAt). Promotion is read from the git base."
  },
  "site-config": {
    "layers": [
      {
        "git": "src/site.config.ts",
        "format": "typescript"
      }
    ],
    "writeBack": [],
    "origin": "owner",
    "recovery": "keep",
    "purposes": ["identity", "content"],
    "description": "Site identity, navigation and profile-derived links, written by the owner in git."
  },
  "tags": {
    "layers": [
      {
        "git": "src/tags.ts",
        "format": "typescript"
      }
    ],
    "writeBack": [],
    "origin": "owner",
    "recovery": "keep",
    "purposes": ["identity", "content"],
    "description": "The tag registry used to validate and label content, written by the owner in git."
  },
  "ap-config": {
    "layers": [
      {
        "git": "src/integrations/activitypub/config.ts",
        "format": "typescript"
      }
    ],
    "writeBack": [],
    "origin": "owner",
    "recovery": "keep",
    "purposes": ["identity", "content"],
    "description": "ActivityPub identity and publication policy, written by the owner in git."
  },
  "auth-config": {
    "layers": [
      {
        "git": "src/integrations/auth/config.ts",
        "format": "typescript"
      }
    ],
    "writeBack": [],
    "origin": "owner",
    "recovery": "keep",
    "purposes": ["auth"],
    "description": "OAuth client and access policy, written by the owner in git."
  },
  "AP_KEY_JWK": {
    "layers": [{ "external": true }],
    "writeBack": [],
    "origin": "owner",
    "recovery": "owner-held",
    "purposes": ["identity", "auth"],
    "description": "The actor signing secret; listed by name so a move requires the owner's copy."
  },
  "GITHUB_CLIENT_SECRET": {
    "layers": [{ "external": true }],
    "writeBack": [],
    "origin": "owner",
    "recovery": "owner-held",
    "purposes": ["identity", "auth"],
    "description": "The OAuth client secret; listed by name so a move requires the owner's copy."
  },
  "CLOUDFLARE_API_TOKEN": {
    "layers": [{ "external": true }],
    "writeBack": [],
    "origin": "owner",
    "recovery": "owner-held",
    "purposes": ["deployment"],
    "description": "The CI deployment secret; listed by name so a move requires the owner's copy."
  },
  "CLOUDFLARE_ACCOUNT_ID": {
    "layers": [{ "external": true }],
    "writeBack": [],
    "origin": "owner",
    "recovery": "none",
    "purposes": ["deployment"],
    "description": "The GitHub repository variable selecting the Cloudflare account."
  },
  "CF_KV_ID": {
    "layers": [{ "external": true }],
    "writeBack": [],
    "origin": "owner",
    "recovery": "none",
    "purposes": ["deployment"],
    "description": "The GitHub repository variable selecting the Workers KV namespace."
  },
  "CF_D1_ID": {
    "layers": [{ "external": true }],
    "writeBack": [],
    "origin": "owner",
    "recovery": "none",
    "purposes": ["deployment"],
    "description": "The GitHub repository variable selecting the D1 database."
  },
  "wrangler-template": {
    "layers": [
      {
        "git": "wrangler.jsonc.template",
        "format": "jsonc"
      }
    ],
    "writeBack": [],
    "origin": "owner",
    "recovery": "none",
    "purposes": ["deployment"],
    "description": "The tracked site Worker deployment template, rewritten for a host move."
  },
  "wrangler-config": {
    "layers": [{ "external": true }],
    "writeBack": [],
    "origin": "owner",
    "recovery": "none",
    "purposes": ["deployment"],
    "description": "The generated site Worker deployment file; recreated from the template."
  },
  "consumer-wrangler": {
    "layers": [
      {
        "git": "worker/wrangler.jsonc",
        "format": "jsonc"
      }
    ],
    "writeBack": [],
    "origin": "owner",
    "recovery": "none",
    "purposes": ["deployment"],
    "description": "The tracked queue consumer deployment configuration, rewritten for a host move."
  },
  "webfinger-repo": {
    "layers": [{ "external": true }],
    "writeBack": [],
    "origin": "owner",
    "recovery": "owner-held",
    "purposes": ["identity", "deployment"],
    "description": "The external repository serving WebFinger for the handle domain."
  },
  "redirect-rule": {
    "layers": [{ "external": true }],
    "writeBack": [],
    "origin": "owner",
    "recovery": "owner-held",
    "purposes": ["identity", "deployment"],
    "description": "The external apex redirect that sends non-federated paths to the blog."
  }
}
